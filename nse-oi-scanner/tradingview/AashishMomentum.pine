// @version=5
// =============================================================================
//  AASHISH MOMENTUM  —  the same rules the Python system trades, on a chart.
//
//  This is not a new idea drawn in Pine. It is the strategy that survived the
//  walk-forward, written out so it can be seen bar by bar and argued with.
//
//  WHAT IT TRADES
//    Trend      EMA(fast) > EMA(slow) AND close > EMA(slow).
//               This one filter did the work in every test. The rotation
//               (RRG) was measured at -6.3% after costs and is not here.
//    VWAP       price above the session VWAP - buyers paying up today.
//    RVOL       volume above its own norm. A move without participation is noise.
//    SQUEEZE    recent true range against its longer norm. Below the coil
//               threshold means the name is compressed.
//    EXPANSION  it WAS coiled and this bar is wider than normal. That bar is
//               the entry - the start of the move, not the fifth bar of it.
//
//  WHAT IT DOES NOT DO
//    It does not predict. "Enter before momentum" is not a thing anyone does;
//    entering on the first expansion bar is, and that is what this marks.
//
//  EXITS
//    Stop at entry - mult x ATR. It TRAILS from the high-water mark at the same
//    distance and never loosens - booking half at T1 raises the stop to
//    breakeven only if that is higher than where the trail already is.
//
//  Defaults are the 15-minute intraday settings. Not financial advice.
// =============================================================================

strategy("Aashish Momentum (15m)", overlay=true, initial_capital=200000,
         default_qty_type=strategy.percent_of_equity, default_qty_value=20,
         commission_type=strategy.commission.percent, commission_value=0.05,
         slippage=2, calc_on_every_tick=false, process_orders_on_close=true)

// ---------------------------------------------------------------- inputs ----
grpT = "Trend"
emaFast = input.int(10,  "EMA fast",        group=grpT, minval=2)
emaSlow = input.int(30,  "EMA slow",        group=grpT, minval=3)

grpF = "Filters"
useVwap  = input.bool(true,  "Require price above VWAP",   group=grpF)
useRvol  = input.bool(true,  "Require relative volume",    group=grpF)
rvolLen  = input.int(20,     "RVOL lookback",              group=grpF, minval=5)
rvolMin  = input.float(1.2,  "RVOL minimum",               group=grpF, step=0.1)
useExp   = input.bool(true,  "Require expansion bar",      group=grpF,
     tooltip="The bar a coil breaks. Rare by design - a signal that fires every bar is not a signal.")
sqShort  = input.int(6,      "Squeeze - short TR window",  group=grpF, minval=2)
sqLong   = input.int(30,     "Squeeze - long TR window",   group=grpF, minval=10)
coil     = input.float(0.70, "Coil threshold",             group=grpF, step=0.05,
     tooltip="Short-window range divided by long-window range. Below this, the name is compressed.")

grpR = "Risk"
atrLen   = input.int(14,    "ATR length",        group=grpR, minval=2)
stopMult = input.float(2.0, "Stop = ATR x",      group=grpR, step=0.5)
t1Mult   = input.float(3.0, "T1 = ATR x",        group=grpR, step=0.5)
t2Mult   = input.float(6.0, "T2 = ATR x",        group=grpR, step=0.5)
useTrail = input.bool(true, "Trail the stop",    group=grpR)
timeoutB = input.int(10,    "Time out after N bars", group=grpR, minval=0,
     tooltip="Dead money is a cost. 0 disables.")

grpS = "Session"
eodExit  = input.bool(true,  "Square off before the close", group=grpS)
eodTime  = input.session("1500-1520", "Square-off window",  group=grpS)

// ------------------------------------------------------------ indicators ----
ef = ta.ema(close, emaFast)
es = ta.ema(close, emaSlow)
trendUp = ef > es and close > es

vw = ta.vwap(hlc3)                       // resets each session, which is the point
aboveVwap = close > vw

rvol = volume / math.max(ta.sma(volume, rvolLen), 1)

tr    = ta.tr(true)
trS   = ta.sma(tr, sqShort)
trL   = ta.sma(tr, sqLong)
squeeze = trL > 0 ? trS / trL : 1.0
// Coiled on the PREVIOUS bar, wide on THIS one. Using this bar for both would be
// asking the break to have happened before it happened.
expansion = squeeze[1] < coil and tr > trL

atr = ta.atr(atrLen)

// ------------------------------------------------------------- the entry ----
okTrend = trendUp
okVwap  = not useVwap or aboveVwap
okRvol  = not useRvol or rvol >= rvolMin
okExp   = not useExp  or expansion
longSignal = okTrend and okVwap and okRvol and okExp

inSession = not eodExit or not (time(timeframe.period, eodTime) and barstate.isconfirmed)

if longSignal and strategy.position_size == 0 and inSession
    strategy.entry("L", strategy.long)

// -------------------------------------------------------------- the exit ----
var float entryPx  = na
var float stopPx   = na
var float highWater = na
var int   barsHeld = 0

if strategy.position_size > 0 and strategy.position_size[1] == 0
    entryPx  := close
    stopPx   := close - stopMult * atr
    highWater := close
    barsHeld := 0

if strategy.position_size > 0
    barsHeld += 1
    highWater := math.max(nz(highWater, close), high)
    if useTrail
        // Ratchet only. A stop that can loosen is not a stop, it is a hope.
        trailed = highWater - stopMult * atr
        stopPx := math.max(nz(stopPx, trailed), trailed)

t1 = entryPx + t1Mult * atr
t2 = entryPx + t2Mult * atr

if strategy.position_size > 0
    strategy.exit("X", from_entry="L", stop=stopPx, limit=t2)
    if timeoutB > 0 and barsHeld >= timeoutB and close < t1
        strategy.close("L", comment="timeout")

if eodExit and time(timeframe.period, eodTime)
    strategy.close("L", comment="EOD")

// ------------------------------------------------------------------ plots ----
plot(ef, "EMA fast", color=color.new(color.aqua, 40), linewidth=1)
plot(es, "EMA slow", color=color.new(color.orange, 40), linewidth=1)
plot(vw, "VWAP",     color=color.new(color.yellow, 20), linewidth=2)

plot(strategy.position_size > 0 ? stopPx : na, "Stop", color=color.new(color.red, 0),
     style=plot.style_linebr, linewidth=2)
plot(strategy.position_size > 0 ? t1 : na, "T1", color=color.new(color.green, 30),
     style=plot.style_linebr)
plot(strategy.position_size > 0 ? t2 : na, "T2", color=color.new(color.green, 0),
     style=plot.style_linebr)

bgcolor(squeeze < coil ? color.new(color.blue, 90) : na, title="coiled")
plotshape(longSignal and strategy.position_size == 0, "entry bar",
          style=shape.triangleup, location=location.belowbar,
          color=color.new(color.green, 0), size=size.tiny)

// A compact read-out, because the numbers behind a signal matter more than the arrow
var table t = table.new(position.top_right, 2, 5, border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "trend",   text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 0, trendUp ? "up" : "no", text_size=size.small,
               text_color=trendUp ? color.green : color.red)
    table.cell(t, 0, 1, "vs VWAP", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 1, aboveVwap ? "above" : "below", text_size=size.small,
               text_color=aboveVwap ? color.green : color.red)
    table.cell(t, 0, 2, "RVOL",    text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(rvol, "#.##"), text_size=size.small,
               text_color=rvol >= rvolMin ? color.green : color.red)
    table.cell(t, 0, 3, "squeeze", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(squeeze, "#.##"), text_size=size.small,
               text_color=squeeze < coil ? color.blue : color.gray)
    table.cell(t, 0, 4, "ATR",     text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 4, str.tostring(atr, "#.##"), text_size=size.small)

alertcondition(longSignal, "Aashish Momentum - entry",
     "Entry bar: trend up, above VWAP, RVOL ok, expansion")
