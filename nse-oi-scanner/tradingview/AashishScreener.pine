// @version=6
// =============================================================================
//  AASHISH SCREENER  —  which names are passing the system, as a table on the chart.
//
//  The same five gates the Python system runs, evaluated on 20 symbols and printed
//  as a table. A row goes green only when every gate it needs is true.
//
//  WHAT THIS IS NOT
//  It is not the scanner. TradingView caps a script at 40 `request.*` calls, so this
//  sees 20 names while the Python system sees the whole F&O list. And it does NOT
//  compute what a ticket needs - the option chain, the lot size, the premium, the
//  charges, or the support/resistance levels the desk draws. A green row here means
//  "worth opening the desk for". It never means "place this".
//
//  THE GATES  (same defaults as config.py / features.py)
//    TREND      EMA(10) > EMA(30) and close > EMA(30)
//    VWAP       price above the session VWAP
//    RVOL       volume / SMA(volume, 20) >= 1.2
//    SQUEEZE    SMA(TR,6) / SMA(TR,30); below the coil threshold means compressed
//    EXPANSION  it WAS coiled on the previous bar and THIS bar is wider than normal
//
//  REPAINTING - read before trusting a live row
//  The last bar is not finished, so every value in it can change until the candle
//  closes and a row can turn green and back inside one candle. That is not a bug and
//  not avoidable: expansion is a statement about a bar, and a forming bar has not
//  made its statement yet. Tick "confirmed bars only" to see only closed candles.
//
//  Defaults are the 15-minute intraday settings. NOT financial advice.
// =============================================================================

indicator("Aashish Screener (F&O)", overlay = true)

// ---------------------------------------------------------------- gates ----
grpG = "Gates (same as the Python system)"
emaFast = input.int(10,    "EMA fast",       group = grpG, minval = 2)
emaSlow = input.int(30,    "EMA slow",       group = grpG, minval = 3)
rvolLen = input.int(20,    "RVOL lookback",  group = grpG, minval = 5)
rvolMin = input.float(1.2, "RVOL minimum",   group = grpG, step = 0.1)
sqShort = input.int(6,     "Squeeze - short TR window", group = grpG, minval = 2)
sqLong  = input.int(30,    "Squeeze - long TR window",  group = grpG, minval = 10)
coil    = input.float(0.70,"Coil threshold",  group = grpG, step = 0.05)

grpR = "What a PASS requires"
needVwap  = input.bool(true, "above VWAP",    group = grpR)
needRvol  = input.bool(true, "RVOL",          group = grpR)
needExp   = input.bool(true, "expansion bar", group = grpR,
     tooltip = "The bar a coil breaks. Rare by design - a screener that lights up every bar is a list, not a signal.")
confirmed = input.bool(false, "confirmed bars only (no live bar)", group = grpR,
     tooltip = "The live bar is unfinished, so its row can flip until the candle closes.")
onlyPass  = input.bool(false, "show only passing names", group = grpR)

grpS = "Symbols  (blank = this chart's symbol)"
s01 = input.symbol("NSE:RELIANCE",   "1",  group = grpS)
s02 = input.symbol("NSE:HDFCBANK",   "2",  group = grpS)
s03 = input.symbol("NSE:ICICIBANK",  "3",  group = grpS)
s04 = input.symbol("NSE:INFY",       "4",  group = grpS)
s05 = input.symbol("NSE:TCS",        "5",  group = grpS)
s06 = input.symbol("NSE:SBIN",       "6",  group = grpS)
s07 = input.symbol("NSE:AXISBANK",   "7",  group = grpS)
s08 = input.symbol("NSE:ITC",        "8",  group = grpS)
s09 = input.symbol("NSE:LT",         "9",  group = grpS)
s10 = input.symbol("NSE:BHARTIARTL", "10", group = grpS)
s11 = input.symbol("NSE:KOTAKBANK",  "11", group = grpS)
s12 = input.symbol("NSE:MARUTI",     "12", group = grpS)
s13 = input.symbol("NSE:TATAMOTORS", "13", group = grpS)
s14 = input.symbol("NSE:TATASTEEL",  "14", group = grpS)
s15 = input.symbol("NSE:HINDALCO",   "15", group = grpS)
s16 = input.symbol("NSE:ADANIENT",   "16", group = grpS)
s17 = input.symbol("NSE:BAJFINANCE", "17", group = grpS)
s18 = input.symbol("NSE:SUNPHARMA",  "18", group = grpS)
s19 = input.symbol("NSE:WIPRO",      "19", group = grpS)
s20 = input.symbol("NSE:TITAN",      "20", group = grpS)

// ------------------------------------------------------------ the gates ----
// One function, run on the chart symbol and on every requested one, so a table row
// and the chart it sends you to cannot disagree about whether a name passed.
scan() =>
    ef      = ta.ema(close, emaFast)
    es      = ta.ema(close, emaSlow)
    trendUp = ef > es and close > es
    aboveVw = close > ta.vwap(hlc3)
    rv      = volume / math.max(ta.sma(volume, rvolLen), 1)
    tr      = ta.tr(true)
    trL     = ta.sma(tr, sqLong)
    sq      = trL > 0 ? ta.sma(tr, sqShort) / trL : 1.0
    // Coiled on the PREVIOUS bar, wide on THIS one. Reading both off this bar asks
    // the break to have happened before it happened.
    expand  = sq[1] < coil and tr > trL
    chg     = close[1] > 0 ? (close / close[1] - 1) * 100 : 0.0
    ok      = trendUp and (not needVwap or aboveVw) and (not needRvol or rv >= rvolMin) and (not needExp or expand)
    [close, chg, trendUp, aboveVw, rv, sq, expand, ok]

// An empty input would make request.security throw, so blank falls back to this
// chart - a duplicated row is a small annoyance, a broken script is not.
pick(s) => str.length(s) > 0 ? s : syminfo.tickerid
// `confirmed` shifts every read back one bar, so nothing unfinished is displayed.
off = confirmed ? 1 : 0

[c01, h01, t01, v01, r01, q01, x01, p01] = request.security(pick(s01), timeframe.period, scan())
[c02, h02, t02, v02, r02, q02, x02, p02] = request.security(pick(s02), timeframe.period, scan())
[c03, h03, t03, v03, r03, q03, x03, p03] = request.security(pick(s03), timeframe.period, scan())
[c04, h04, t04, v04, r04, q04, x04, p04] = request.security(pick(s04), timeframe.period, scan())
[c05, h05, t05, v05, r05, q05, x05, p05] = request.security(pick(s05), timeframe.period, scan())
[c06, h06, t06, v06, r06, q06, x06, p06] = request.security(pick(s06), timeframe.period, scan())
[c07, h07, t07, v07, r07, q07, x07, p07] = request.security(pick(s07), timeframe.period, scan())
[c08, h08, t08, v08, r08, q08, x08, p08] = request.security(pick(s08), timeframe.period, scan())
[c09, h09, t09, v09, r09, q09, x09, p09] = request.security(pick(s09), timeframe.period, scan())
[c10, h10, t10, v10, r10, q10, x10, p10] = request.security(pick(s10), timeframe.period, scan())
[c11, h11, t11, v11, r11, q11, x11, p11] = request.security(pick(s11), timeframe.period, scan())
[c12, h12, t12, v12, r12, q12, x12, p12] = request.security(pick(s12), timeframe.period, scan())
[c13, h13, t13, v13, r13, q13, x13, p13] = request.security(pick(s13), timeframe.period, scan())
[c14, h14, t14, v14, r14, q14, x14, p14] = request.security(pick(s14), timeframe.period, scan())
[c15, h15, t15, v15, r15, q15, x15, p15] = request.security(pick(s15), timeframe.period, scan())
[c16, h16, t16, v16, r16, q16, x16, p16] = request.security(pick(s16), timeframe.period, scan())
[c17, h17, t17, v17, r17, q17, x17, p17] = request.security(pick(s17), timeframe.period, scan())
[c18, h18, t18, v18, r18, q18, x18, p18] = request.security(pick(s18), timeframe.period, scan())
[c19, h19, t19, v19, r19, q19, x19, p19] = request.security(pick(s19), timeframe.period, scan())
[c20, h20, t20, v20, r20, q20, x20, p20] = request.security(pick(s20), timeframe.period, scan())

// ------------------------------------------------------------- the table ----
cHead = color.new(#161b22, 0)
cPass = color.new(#0d2b18, 0)
cRow  = color.new(#0b0f14, 0)
cTxt  = color.new(#c9d1d9, 0)
cDim  = color.new(#6e7781, 0)
cUp   = color.new(#3fb950, 0)
cDn   = color.new(#f85149, 0)
cBlue = color.new(#58a6ff, 0)

var table t = table.new(position.top_right, 8, 23, border_width = 1,
     frame_width = 1, frame_color = color.new(color.gray, 60))

// Pine functions cannot assign to a global, so this RETURNS the next row index and
// the caller advances the counter. Writing it the obvious way - mutating `row`
// inside the function - does not compile at all.
row(i, sym, c, ch, tu, av, rv, sq, ex, ok) =>
    nxt = i
    if barstate.islast and i < 22 and (not onlyPass or ok)
        bg = ok ? cPass : cRow
        nm = str.replace_all(str.replace_all(sym, "NSE:", ""), "BSE:", "")
        table.cell(t, 0, i, nm, bgcolor = bg, text_color = cTxt, text_size = size.tiny)
        table.cell(t, 1, i, str.tostring(c, format.mintick), bgcolor = bg,
             text_color = cTxt, text_size = size.tiny)
        table.cell(t, 2, i, str.tostring(ch, "#.##") + "%", bgcolor = bg,
             text_color = ch >= 0 ? cUp : cDn, text_size = size.tiny)
        table.cell(t, 3, i, tu ? "up" : "no", bgcolor = bg,
             text_color = tu ? cUp : cDn, text_size = size.tiny)
        table.cell(t, 4, i, av ? "upar" : "neeche", bgcolor = bg,
             text_color = av ? cUp : cDn, text_size = size.tiny)
        table.cell(t, 5, i, str.tostring(rv, "#.##"), bgcolor = bg,
             text_color = rv >= rvolMin ? cUp : cDim, text_size = size.tiny)
        table.cell(t, 6, i, str.tostring(sq, "#.##") + (ex ? "  !" : ""), bgcolor = bg,
             text_color = ex ? cUp : (sq < coil ? cBlue : cDim), text_size = size.tiny)
        table.cell(t, 7, i, ok ? "PASS" : "wait", bgcolor = bg,
             text_color = ok ? cUp : cDim, text_size = size.tiny)
        nxt := i + 1
    nxt

if barstate.islast
    table.cell(t, 0, 0, "NAAM",   bgcolor = cHead, text_color = cDim, text_size = size.tiny)
    table.cell(t, 1, 0, "LTP",    bgcolor = cHead, text_color = cDim, text_size = size.tiny)
    table.cell(t, 2, 0, "%",      bgcolor = cHead, text_color = cDim, text_size = size.tiny)
    table.cell(t, 3, 0, "TREND",  bgcolor = cHead, text_color = cDim, text_size = size.tiny)
    table.cell(t, 4, 0, "VWAP",   bgcolor = cHead, text_color = cDim, text_size = size.tiny)
    table.cell(t, 5, 0, "RVOL",   bgcolor = cHead, text_color = cDim, text_size = size.tiny)
    table.cell(t, 6, 0, "SQZ",    bgcolor = cHead, text_color = cDim, text_size = size.tiny)
    table.cell(t, 7, 0, "SIGNAL", bgcolor = cHead, text_color = cDim, text_size = size.tiny)

n = 1
n := row(n, s01, c01[off], h01[off], t01[off], v01[off], r01[off], q01[off], x01[off], p01[off])
n := row(n, s02, c02[off], h02[off], t02[off], v02[off], r02[off], q02[off], x02[off], p02[off])
n := row(n, s03, c03[off], h03[off], t03[off], v03[off], r03[off], q03[off], x03[off], p03[off])
n := row(n, s04, c04[off], h04[off], t04[off], v04[off], r04[off], q04[off], x04[off], p04[off])
n := row(n, s05, c05[off], h05[off], t05[off], v05[off], r05[off], q05[off], x05[off], p05[off])
n := row(n, s06, c06[off], h06[off], t06[off], v06[off], r06[off], q06[off], x06[off], p06[off])
n := row(n, s07, c07[off], h07[off], t07[off], v07[off], r07[off], q07[off], x07[off], p07[off])
n := row(n, s08, c08[off], h08[off], t08[off], v08[off], r08[off], q08[off], x08[off], p08[off])
n := row(n, s09, c09[off], h09[off], t09[off], v09[off], r09[off], q09[off], x09[off], p09[off])
n := row(n, s10, c10[off], h10[off], t10[off], v10[off], r10[off], q10[off], x10[off], p10[off])
n := row(n, s11, c11[off], h11[off], t11[off], v11[off], r11[off], q11[off], x11[off], p11[off])
n := row(n, s12, c12[off], h12[off], t12[off], v12[off], r12[off], q12[off], x12[off], p12[off])
n := row(n, s13, c13[off], h13[off], t13[off], v13[off], r13[off], q13[off], x13[off], p13[off])
n := row(n, s14, c14[off], h14[off], t14[off], v14[off], r14[off], q14[off], x14[off], p14[off])
n := row(n, s15, c15[off], h15[off], t15[off], v15[off], r15[off], q15[off], x15[off], p15[off])
n := row(n, s16, c16[off], h16[off], t16[off], v16[off], r16[off], q16[off], x16[off], p16[off])
n := row(n, s17, c17[off], h17[off], t17[off], v17[off], r17[off], q17[off], x17[off], p17[off])
n := row(n, s18, c18[off], h18[off], t18[off], v18[off], r18[off], q18[off], x18[off], p18[off])
n := row(n, s19, c19[off], h19[off], t19[off], v19[off], r19[off], q19[off], x19[off], p19[off])
n := row(n, s20, c20[off], h20[off], t20[off], v20[off], r20[off], q20[off], x20[off], p20[off])

// How many passed, out of how many were asked. "0 / 20" is a real answer and the
// common one - a screener that never says zero is not filtering anything.
hits = (p01[off] ? 1 : 0) + (p02[off] ? 1 : 0) + (p03[off] ? 1 : 0) + (p04[off] ? 1 : 0) +
       (p05[off] ? 1 : 0) + (p06[off] ? 1 : 0) + (p07[off] ? 1 : 0) + (p08[off] ? 1 : 0) +
       (p09[off] ? 1 : 0) + (p10[off] ? 1 : 0) + (p11[off] ? 1 : 0) + (p12[off] ? 1 : 0) +
       (p13[off] ? 1 : 0) + (p14[off] ? 1 : 0) + (p15[off] ? 1 : 0) + (p16[off] ? 1 : 0) +
       (p17[off] ? 1 : 0) + (p18[off] ? 1 : 0) + (p19[off] ? 1 : 0) + (p20[off] ? 1 : 0)

if barstate.islast and n < 23
    table.cell(t, 0, n, "PASS", bgcolor = cHead, text_color = cDim, text_size = size.tiny)
    table.cell(t, 1, n, str.tostring(hits) + " / 20", bgcolor = cHead,
         text_color = hits > 0 ? cUp : cDim, text_size = size.tiny)
    table.cell(t, 2, n, timeframe.period, bgcolor = cHead, text_color = cDim,
         text_size = size.tiny)
    table.cell(t, 3, n, confirmed ? "closed bars" : "LIVE bar", bgcolor = cHead,
         text_color = confirmed ? cDim : color.new(#d29922, 0), text_size = size.tiny)
    table.cell(t, 4, n, "", bgcolor = cHead)
    table.cell(t, 5, n, "", bgcolor = cHead)
    table.cell(t, 6, n, "", bgcolor = cHead)
    table.cell(t, 7, n, "desk khol", bgcolor = cHead, text_color = cDim,
         text_size = size.tiny)

// ---------------------------------------------------- this chart's symbol ----
// The chart in front of you is scanned too and drawn, so the table can be checked
// against something visible instead of trusted blind.
[c0, h0, t0, v0, r0, q0, x0, p0] = scan()
plot(ta.ema(close, emaFast), "EMA fast", color = color.new(color.aqua, 40))
plot(ta.ema(close, emaSlow), "EMA slow", color = color.new(color.orange, 40))
plot(ta.vwap(hlc3), "VWAP", color = color.new(color.yellow, 20), linewidth = 2)
bgcolor(q0 < coil ? color.new(color.blue, 92) : na, title = "coiled")
plotshape(p0, "PASS on this symbol", style = shape.triangleup,
     location = location.belowbar, color = color.new(color.green, 0), size = size.tiny)

alertcondition(p0, "Aashish Screener - this symbol passes",
     "Gates pass: trend up, above VWAP, RVOL ok, expansion bar")
